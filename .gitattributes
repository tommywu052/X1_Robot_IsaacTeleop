# These are run by bash on Linux/WSL. A CRLF checkout makes bash fail on the
# shebang line, which reads as "the script is broken" rather than "wrong endings".
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
